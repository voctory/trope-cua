<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AssemblyName>trope-cua</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Authors>Victor Vannara</Authors>
    <Copyright>Copyright (c) 2026 Victor Vannara</Copyright>
    <Description>Windows background computer-use driver for MCP clients and automation agents.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/voctory/trope-cua</PackageProjectUrl>
    <RepositoryUrl>https://github.com/voctory/trope-cua</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
